# Password for the organizer dashboard (/admin). Required in production.
ADMIN_PASSWORD=change-me

# Random string used to sign login cookies. Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Storage (Upstash Redis, free tier). Vercel sets these automatically when you add
# Upstash Redis from the Storage tab. Without them, local dev stores data in .data/db.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional: Vercel Blob (free tier) enables file attachments on submissions.
# Set automatically when you create a Blob store in the Storage tab.
BLOB_READ_WRITE_TOKEN=
